# Archivo de ejemplo de variables de entorno para desarrollo local del Backend
# Copiar este archivo como .env y completar con los valores reales

# Perfil de Spring: dev o prod. Controla qué migraciones de Flyway se cargan
# (dev = schema + dev-data con datos de prueba; prod = solo schema).
SPRING_PROFILE=dev

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scheduleDB
DB_USERNAME=tu_usuario_db
DB_PASSWORD=tu_password_db

# Configuración de Seguridad - Usuario básico
SECURITY_USER_NAME=tu_usuario_admin
SECURITY_USER_PASSWORD=tu_password_admin

# JWT Configuration
JWT_PRIVATE_KEY=tu_clave_privada_jwt_aqui
JWT_USER_GENERATOR=AUTH0JWT-BACKEND
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# CORS Configuration (separar URLs con coma)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

# Correo SMTP (Gmail) para invitaciones y recuperación de contraseña
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_password_de_aplicacion_gmail

# URL base del frontend para construir el enlace de invitación (sin valor por
# defecto en application.properties: si falta, la aplicación no arranca)
INVITATION_BASE_URL=http://localhost:4200/invitation

# Puerto del servidor (opcional, por defecto 8080)
SERVER_PORT=8080

# Puerto publicado por docker-compose para el contenedor del backend
BACKEND_PORT=8080
